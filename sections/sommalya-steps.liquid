
<section {% render 'sommalya-section-attrs', settings: section.settings %}>
  <div class="sm__wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <header class="sm-head sm-head--{{ section.settings.head_layout | default: 'center' }}">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="sm-eyebrow{% if section.settings.head_layout == 'center' %} sm-eyebrow--plain{% endif %}">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="sm-h2">{{ section.settings.heading }}</h2>{%- endif -%}
        </div>
        {%- if section.settings.text != blank -%}<p class="sm-lead">{{ section.settings.text | newline_to_br }}</p>{%- endif -%}
      </header>
    {%- endif -%}
    <ol class="sm-steps" role="list" style="list-style: none; margin: 0; padding: 0;">
      {%- for block in section.blocks -%}
        <li class="sm-step" {{ block.shopify_attributes }}>
          <h3 class="sm-h3">{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Sommalya · Pasos",
  "tag": "div",
  "class": "sommalya-steps",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Modo de uso"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "info": "Usa cursiva para resaltar una palabra con el color de acento.",
      "default": "Un hábito <em>sencillo.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "select",
      "id": "head_layout",
      "label": "Disposición del encabezado",
      "options": [
        {
          "value": "center",
          "label": "Centrado"
        },
        {
          "value": "split",
          "label": "Dividido"
        },
        {
          "value": "left",
          "label": "Izquierda"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Apariencia"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        {
          "value": "base",
          "label": "Marfil (base)"
        },
        {
          "value": "soft",
          "label": "Lino suave"
        },
        {
          "value": "sand",
          "label": "Arena"
        },
        {
          "value": "ink",
          "label": "Oscuro"
        }
      ],
      "default": "base"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Color de acento",
      "info": "Opcional. Por defecto usa el verde salvia de la paleta."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Paso"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sommalya · Pasos"
    }
  ]
}
{% endschema %}
