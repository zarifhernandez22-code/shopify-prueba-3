{% doc %}
  Ilustración de frasco Sommalya usada como marcador de posición mientras no
  haya fotografía de producto.

  @param {string} [label] - nombre en la etiqueta
  @param {string} [accent] - color de acento de la etiqueta
{% enddoc %}
{%- assign bottle_accent = accent | default: 'var(--sm-accent)' -%}
<div class="sm-placeholder">
  <svg viewBox="0 0 200 300" role="img" aria-label="{{ label | default: 'Sommalya' | escape }}">
    <rect x="62" y="8" width="76" height="40" rx="6" fill="#2a332e"/>
    <rect x="58" y="44" width="84" height="10" rx="3" fill="#3a443e"/>
    <path d="M40 78c0-14 10-24 24-24h72c14 0 24 10 24 24v190c0 13-10 22-22 22H62c-12 0-22-9-22-22V78Z" fill="#fbfaf7"/>
    <path d="M40 78c0-14 10-24 24-24h72c14 0 24 10 24 24v190c0 13-10 22-22 22H62c-12 0-22-9-22-22V78Z" fill="none" stroke="rgba(0,0,0,.08)"/>
    <rect x="40" y="120" width="120" height="130" style="fill: {{ bottle_accent }}; opacity: .14"/>
    <text x="100" y="152" text-anchor="middle" font-family="Georgia, serif" font-size="15" letter-spacing="3" fill="#1f2a24">SOMMALYA</text>
    <line x1="80" y1="164" x2="120" y2="164" stroke="#1f2a24" stroke-opacity=".35"/>
    <text x="100" y="190" text-anchor="middle" font-family="Georgia, serif" font-style="italic" font-size="17" fill="#1f2a24">{{ label | default: '' | escape }}</text>
    <text x="100" y="232" text-anchor="middle" font-family="Helvetica, Arial, sans-serif" font-size="6.5" letter-spacing="1.2" fill="#1f2a24" fill-opacity=".6">SUPLEMENTO NATURAL · 60 CÁPS.</text>
  </svg>
</div>
