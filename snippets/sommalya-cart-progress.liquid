{% doc %}
  Barra de progreso hacia el envío gratis. Usa el monto de
  Configuración del tema → Sommalya · Carrito.
{% enddoc %}
{%- liquid
  assign threshold = settings.sommalya_free_shipping | default: 0 | times: 100
  if threshold > 0 and cart.item_count > 0
    assign total = cart.total_price
    assign remaining = threshold | minus: total
    assign pct = total | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
{%- if threshold > 0 and cart.item_count > 0 -%}
  <div class="sm-cartbar{% if remaining <= 0 %} is-complete{% endif %}" role="status">
    <p class="sm-cartbar__text">
      {%- if remaining > 0 -%}
        Te faltan <strong>{{ remaining | money }}</strong> para tu <em>envío gratis.</em>
      {%- else -%}
        {% render 'sommalya-icon', name: 'check' %}Tu pedido tiene <em>envío gratis.</em>
      {%- endif -%}
    </p>
    <div class="sm-cartbar__track" aria-hidden="true"><span style="width: {{ pct }}%;"></span></div>
  </div>
{%- endif -%}
